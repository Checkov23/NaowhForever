package-as: NaowhForever

# Modules shipped as their own addons, beside NaowhForever/ in the zip. Listed so each one
# follows the modules it needs; the tests load them in this order.
move-folders:
  NaowhForever/NaowhForever_Locales: NaowhForever_Locales
  NaowhForever/NaowhForever_Professions: NaowhForever_Professions
  NaowhForever/NaowhForever_Training: NaowhForever_Training
  NaowhForever/NaowhForever_BiS: NaowhForever_BiS
  NaowhForever/NaowhForever_DungeonJournal: NaowhForever_DungeonJournal
  NaowhForever/NaowhForever_Discovery: NaowhForever_Discovery
  NaowhForever/NaowhForever_DiscoveryData: NaowhForever_DiscoveryData
  NaowhForever/NaowhForever_Utilities: NaowhForever_Utilities
  NaowhForever/NaowhForever_Combat: NaowhForever_Combat
  NaowhForever/NaowhForever_QoL: NaowhForever_QoL
  NaowhForever/NaowhForever_JourneysData: NaowhForever_JourneysData
  NaowhForever/NaowhForever_SearchIndex: NaowhForever_SearchIndex

externals:
  Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibCustomGlow-1.0: https://github.com/Stanzilla/LibCustomGlow
  Libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate
  Libs/LibSerialize: https://github.com/rossnichols/LibSerialize
  Libs/LibSharedMedia-3.0: https://repos.curseforge.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
ignore:
  - Tools
  - RELEASE_NOTES.md
  - NaowhForever_DamageMeter
  - PRODUCT.md
